    "contents": [
        {
            "desc": "Stoccolma in inverno"
        },
        {
            "desc": ""
        },
        {
            "desc": "Una città costruita sull’acqua."
        },
        {
            "desc": "E d’inverno, l’acqua rende tutto più affascinante."
        },
        {
            "desc": ""
        },
        {
            "desc": "Dall’alto dei suoi viewpoint, lo sguardo scivola tra canali ghiacciati,"
        },
        {
            "desc": "ponti eleganti e isole che sembrano galleggiare nella luce nordica."
        },
        {
            "desc": ""
        },
        {
            "desc": "Scendi, cammini lungo i moli, attraversi i ponti,"
        },
        {
            "desc": "l’acqua ti accompagna sempre…"
        },
        {
            "desc": " …e se hai fortuna…anche la neve…"
        },
        {
            "desc": ""
        },
        {
            "desc": "Stoccolma d’inverno è un viaggio che resta"
        },
        {
            "desc": ""
        },
        {
            "desc": "@sconfinamente"
        },
        {
            "desc": "quando la bellezza "
        },
        {
            "desc": "ti lascia senza fiato"
        },
        {
            "desc": ""
        },
        {
            "desc": "#sconfinamente #mammaefiglia #svezia #travelcreator #stoccolma",
